# paths.env — Sabit dizin ve yol sozlesmesi
# Bu dosya provision modulleri ve servisler tarafindan okunur.

# Model ve Engine yollari
MODELS_DIR="/data/models"
ENGINES_DIR="/data/engines"
CPU_MODELS_CONF="/data/cpu_models.conf"
CPU_SERVICES_SCRIPT="/data/install_cpu_services.sh"

# LiteLLM yollari
LITELLM_DIR="/opt/litellm"
LITELLM_CONFIG="/opt/litellm/config.yaml"
LITELLM_VENV="/opt/litellm/venv"
LITELLM_BIN="/opt/litellm/venv/bin/litellm"
LITELLM_SERVICE="/etc/systemd/system/litellm.service"

# MCP Web Search yollari
MCP_DIR="/opt/ai_engine"
MCP_SCRIPT="/opt/ai_engine/web_search_mcp.py"
MCP_VENV="/opt/ai_engine/venv"
MCP_PYTHON_BIN="/opt/ai_engine/venv/bin/python3"
MCP_SERVICE="/etc/systemd/system/mcp-web-search.service"

# Konfigurasyon ve Sirlar
AI_CONF_DIR="/etc/ai-brain"
MCP_ENV_FILE="/etc/ai-brain/mcp-web-search.env"
LITELLM_ENV_FILE="/etc/ai-brain/litellm.env"
