# .ai-brain-lxc.env.example
#
# Kopyala:  cp .ai-brain-lxc.env.example .ai-brain-lxc.env
# Sonra degerleri kendi ortamina gore duzenle.
# .ai-brain-lxc.env GIT'E COMMIT EDILMEMELI (.gitignore'a ekli olmali).

# Proxmox host adresi (zorunlu)
AI_PVE_IP=164.102.98.16

# Container ID - bos birakilirsa pvesh ile otomatik atanir
AI_CT_ID=220

AI_STORAGE=local-lvm
AI_BRIDGE=vmbr0

# --- Ag ---
# eth0: ana ag (dhcp ya da static)
AI_MAIN_NET_MODE=static
# AI_MAIN_NET_MODE=static ise asagidakiler zorunlu:
AI_MAIN_NET_IP=164.102.98.90/32
AI_MAIN_NET_GW=164.102.98.70

# eth1: izole VLAN (gateway YOK - kasitli, internete cikamaz)
AI_VLAN_TAG=10
AI_NET_IP=10.10.10.2/24

# --- Kaynak ---
AI_HOSTNAME=ai-brain
AI_CORES=8
AI_MEMORY_MB=28672
AI_SWAP_MB=0
AI_DISK_GB=120

AI_SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"

# --- Hedef Turu (lxc | vm) ---
AI_TARGET_TYPE=lxc
AI_DNS="1.1.1.1 9.9.9.9"

# --- VM Ayarlari (AI_TARGET_TYPE=vm ise) ---
# AI_VM_TEMPLATE_ID=9000
# AI_VM_CPU_TYPE=host

# --- MCP Web Search Ayarlari ---
# MCP_TRANSPORT=sse        # sse | streamable | both
# MCP_MAX_SSE_CONNECTIONS=8
# MCP_SSE_MAX_LIFETIME=0
# MCP_MAX_BODY_BYTES=65536