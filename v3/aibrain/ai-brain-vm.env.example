# .ai-brain-vm.env.example
#
# Proxmox Cloud-Init VM Hedefi Icin Yapilandirma Sablonu
# Kopyala:  cp .ai-brain-vm.env.example .ai-brain-vm.env
# .ai-brain-vm.env GIT'E COMMIT EDILMEMELI (.gitignore'a ekli).

# Proxmox host adresi (zorunlu)
AI_PVE_IP=164.102.98.16

# VM ID - bos birakilirsa pvesh ile otomatik sonraki ID atanir
AI_CT_ID=260

AI_STORAGE=local-lvm
AI_BRIDGE=vmbr0

# --- Ag Yapilandirmasi ---
# eth0 (net0): ana ag (dhcp ya da static)
AI_MAIN_NET_MODE=static
# AI_MAIN_NET_MODE=static ise asagidakiler zorunlu:
AI_MAIN_NET_IP=164.102.98.92/32
AI_MAIN_NET_GW=164.102.98.70

# eth1 (net1): izole VLAN (gateway YOK - internet erisimi engellenmis model agi)
AI_VLAN_TAG=10
AI_NET_IP=10.10.10.2/24

# DNS sunuculari
AI_DNS="1.1.1.1 9.9.9.9"

# --- Kaynaklar ---
AI_HOSTNAME=ai-brain-vm
AI_CORES=8
AI_MEMORY_MB=28672
AI_SWAP_MB=0
AI_DISK_GB=120

# Erisim kullanicisi ve SSH yetkilendirme anahtari
AI_ACCESS_USER=aibrain
AI_SSH_PUBKEY_FILE="$HOME/.ssh/id_ed25519.pub"

# --- VM Template ve Cloud-Init Otomasyonu ---
# Template ID'si biliniyorsa yazin; bos ise veya Proxmox'ta yoksa
# create-vm-template.sh otomatik calistirilip bu ID ile uretilir:
AI_VM_TEMPLATE_ID=9000
AI_VM_AUTO_CREATE_TEMPLATE=true
AI_VM_DISTRO=debian
AI_VM_VERSION=13
AI_VM_CPU_TYPE=host
# Proxmox host'unda libguestfs-tools kurulu ise 'true' yapilabilir:
AI_VM_USE_VIRT_CUSTOMIZE=false

# --- MCP Web Search Ayarlari ---
MCP_TRANSPORT=sse
MCP_MAX_SSE_CONNECTIONS=8
MCP_SSE_MAX_LIFETIME=0
MCP_MAX_BODY_BYTES=65536
